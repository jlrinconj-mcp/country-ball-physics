# Country data
# Optional REST Countries v5 API key (https://restcountries.com). Server-side only.
# When unset, the app uses the open mledoze/countries dataset (ODbL) via jsDelivr.
RESTCOUNTRIES_API_KEY=

# Optional override for the open dataset URL.
COUNTRIES_DATASET_URL=

# Live mode: require ?token=… on /api/live/messages (set this if the app is reachable from the internet).
LIVE_BRIDGE_TOKEN=

# Local video pipeline: official TikTok / Meta publishing credentials.
# Store tokens only in .env.local (ignored by Git). Never use NEXT_PUBLIC_ here.
# Set an API version supported by your Meta app; no implicit version fallback.
META_GRAPH_VERSION=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_ACCESS_TOKEN=
# Must match creator_info options. Unaudited TikTok apps can publish only privately.
TIKTOK_PRIVACY_LEVEL=

# Optional. Dedicated directory only; defaults to output/pipeline.
PIPELINE_ROOT=
PIPELINE_MIN_FREE_BYTES=2147483648
PIPELINE_MAX_ACTIVE_JOBS=10
